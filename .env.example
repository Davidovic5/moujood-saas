# =====================================================================
# Attendance SaaS Template - Environment Configuration
# =====================================================================

# MongoDB Atlas or Local MongoDB Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/attendance_db?retryWrites=true&w=majority

# Strong secret key for signing JSON Web Tokens (Required)
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Server Port (Optional, defaults to 3001)
PORT=3001

# Environment Mode: development | production
NODE_ENV=production

# Multi-Tenant Identifier (Optional, defaults to 'default')
DEFAULT_TENANT_ID=default

# Initial Super Admin Seed Credentials (Used by scripts/seed-clean.js)
SEED_ADMIN_PHONE=01000000000
SEED_ADMIN_PASSWORD=AdminSecurePassword123!
SEED_ADMIN_NAME=المدير العام
